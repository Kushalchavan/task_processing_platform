# PostgreSQL Docker configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=task_processing_db

# Development database
DATABASE_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@127.0.0.1:5433/task_processing_db

# Test database
TEST_DATABASE_URL=postgresql+psycopg://your_postgres_user:your_postgres_password@127.0.0.1:5433/task_processing_test_db


# Redis database 
REDIS_URL=redis://localhost:6379/0